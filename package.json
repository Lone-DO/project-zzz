{
  "name": "@lone-do/zzz",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\"",
    "build:plugin": "vite build --mode plugin",
    "build:dev": "vite build --mode development --watch",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.0.1",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.12",
    "prettier": "3.5.3",
    "sass": "^1.101.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.7",
    "vue-web-component-wrapper": "^1.7.7"
  }
}